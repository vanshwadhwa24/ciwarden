# Only needed for `watch` against a real repo. Use a fine-grained token limited to that one repo.
GITHUB_TOKEN=
# CIWARDEN_MODEL=opencode/deepseek-v4.1-flash-free
# CIWARDEN_OPENCODE=/path/to/opencode
# Optional OpenAI-compatible model (for example Gemini free tier). Keys live in your shell env or .env, never in git.
# CIWARDEN_MODEL=compat:<model-name>
# CIWARDEN_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# CIWARDEN_API_KEY=
# Free-tier guard (defaults shown): at most 4 calls/minute, hard stop at 18 calls per Pacific day
# CIWARDEN_MAX_RPM=4
# CIWARDEN_MAX_RPD=18
